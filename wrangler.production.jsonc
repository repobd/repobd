{
  // Phase 5B production config. Deliberately a separate, self-contained
  // file rather than a named `env.production` block in wrangler.jsonc:
  // Wrangler bindings are not inherited into named environments (rate-limit
  // bindings in particular are declared per-environment), so a standalone
  // file is the form least likely to let a local/production binding mix by
  // accident. Every production-mutating command must pass
  // `--config wrangler.production.jsonc` explicitly — there is no bare
  // command that can resolve against this file by default.
  //
  // No `account_id` in Phase 5B/6C-2-A — `wrangler` resolves it from the
  // authenticated account, which Phase 6C-1 confirmed is the same account
  // that owns the `repobd.com` zone.
  //
  // Human Gate 6C-2-A: the settled v0.1 public origin, attached as a
  // Wrangler-native Worker Custom Domain — not a separate DNS record and
  // not a second Worker/deployment stack. Both hostnames route to this
  // exact Worker/deployment — no second Worker, no second D1.
  //
  // `workers_dev` must be explicit here, not omitted: Wrangler's default
  // for an *omitted* `workers_dev` is context-dependent — once a
  // `custom_domain` route is present, omitting it defaults to `false`
  // instead of `true` (confirmed the hard way, by a real deploy that
  // disabled `workers.dev`, corrected the same Gate). Setting it to `true`
  // explicitly is what actually keeps `repobd-worker.shinya-bj.workers.dev`
  // live alongside `api.repobd.com`, per the settled Human decision to
  // keep it reachable as a fallback during the v0.1 transition.
  // `preview_urls` is set to `false` explicitly for the same reason —
  // relying on an implicit default here is exactly the mistake this
  // comment exists to prevent a second time.
  "workers_dev": true,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "api.repobd.com",
      "custom_domain": true,
      "zone_name": "repobd.com"
    }
  ],
  "name": "repobd-worker",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-08-11",
  // Human Gate A: the real, dedicated RepoBD production D1 database.
  // Created via `wrangler d1 create repobd-production` — verified via a
  // read-only `wrangler d1 list`/`d1 info` immediately afterward: exactly
  // one database on the account, name and id both match. `database_id` is
  // Cloudflare's own generated UUID for that database, not a secret — it
  // is a non-secret resource identifier, the same way `database_name` is.
  // Binding name is `DB`, matching `interface Env` in src/worker/index.ts
  // and the local dev binding in wrangler.jsonc — not Wrangler's suggested
  // default binding name. Migration `0001_create_secrets.sql` was applied
  // at Human Gate B; a read-only check confirmed no migration remained
  // pending afterward.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "repobd-production",
      "database_id": "79800646-dc8a-4dca-97c9-81fed33dc94a"
    }
  ],
  // PRODUCTION thresholds — the values that actually get deployed and
  // enforced. Deliberately different from `wrangler.jsonc` (local/shared-
  // test, 1000/60s on both — see its comment) and, on paper, distinct
  // `namespace_id`s from `wrangler.ratelimit-test.jsonc` (isolated test,
  // same 20/60 + 120/60 thresholds but a separate Miniflare instance), so
  // no environment's counters can share a bucket with another's.
  //
  // `namespace_id` must be a string containing a positive integer (not an
  // arbitrary label) and is a non-secret configuration identifier — never
  // derived from a secret, key, repository identity, delivery id, claim
  // token, or client IP. These two RepoBD-specific IDs are stable and
  // distinct from each other. Gate B verified no pre-existing account-wide
  // namespace collision before production deploy (the account held zero
  // Worker scripts at that time) — a point-in-time check, not a standing
  // guarantee against a future unrelated Worker being misconfigured.
  "ratelimits": [
    {
      "name": "CREATE_LIMITER",
      "namespace_id": "2001",
      "simple": { "limit": 20, "period": 60 }
    },
    {
      "name": "LIFECYCLE_LIMITER",
      "namespace_id": "2002",
      "simple": { "limit": 120, "period": 60 }
    }
  ]
}
