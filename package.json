{
  "name": "repobd",
  "version": "0.1.0",
  "description": "CLI to hand off a secret bound to a Git repository — wrong repo, no secret.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/repobd/repobd.git"
  },
  "bugs": {
    "url": "https://github.com/repobd/repobd/issues"
  },
  "homepage": "https://github.com/repobd/repobd#readme",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "bin": {
    "repobd": "dist/cli/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.typecheck.json && tsc -p src/worker/tsconfig.json",
    "test": "vitest run",
    "cli": "tsx src/cli/index.ts",
    "d1:migrate:production": "wrangler d1 migrations apply DB --config wrangler.production.jsonc --remote",
    "deploy:production": "wrangler deploy --config wrangler.production.jsonc"
  },
  "dependencies": {
    "commander": "15.0.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.21.3",
    "@cloudflare/workers-types": "^5.20260811.1",
    "@types/node": "22.20.1",
    "tsx": "^4.19.2",
    "typescript": "7.0.2",
    "vitest": "4.1.10",
    "wrangler": "4.123.0"
  }
}
